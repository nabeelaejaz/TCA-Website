---
import DotTCA from "./DotTCA.astro";
---

<footer id="footer" class="md:mt-[80px] mt-[60px]">
  <div class="bg-[#E8E8E8] w-[100%] md:h-[424px] h-[340px]">
    <div class="md:flex">
      <div>
        <a href="mailto:hello@tca.com.pk">
          <div class="flex ml-[48px] pt-[46px]">
            <img class="md:w-10 w-8" src="/email.svg" width="40" height="40" loading="lazy" decoding="async" alt="Email Us" />
            <p class="ml-[16px] lg:text-[24px] md:text-[22px] text-[20px]">hello@tca.com.pk</p>
          </div>
        </a>
        <hr class="md:w-80 h-[1px] mx-[48px] my-4 bg-[#5E5E5E] border-0 md:my-6" />
        <a href="https://wa.me/923052837680" target="_blank" rel="noopener noreferrer">
          <div class="flex ml-[48px] pt-[10px]">
            <img class="md:w-10 w-8" src="/phone.svg" width="40" height="40" loading="lazy" decoding="async" alt="Call Us" />
            <p class="ml-[16px] lg:text-[24px] md:text-[22px] text-[20px]">+92 305 2837680</p>
          </div>
        </a>
        <hr class="md:w-80 h-[1px] mx-[48px] my-4 bg-[#5E5E5E] border-0 md:my-6" />
        <a href="/careers#header">
          <div class="flex ml-[48px] pt-[10px]">
            <img class="md:w-10 w-8" src="/sprout.svg" width="40" height="40" loading="lazy" decoding="async" alt="Work with us" />
            <p class="ml-[16px] lg:text-[24px] md:text-[22px] text-[20px]">Careers</p>
          </div>
        </a>
        <hr class="md:w-80 h-[1px] mx-[48px] my-4 bg-[#5E5E5E] border-0 md:my-6" />
        <a href="/contact#header">
          <div class="flex ml-[48px] pt-[10px]">
            <img class="md:w-10 w-8" src="/phrase-sentiment.svg" width="40" height="40" loading="lazy" decoding="async" alt="Contact Us" />
            <p class="ml-[16px] lg:text-[24px] md:text-[22px] text-[20px]">Contact Us</p>
          </div>
        </a>
      </div>
      <div class="w-[100%]">
        <a href="#header" aria-label="Back to top">
          <img
            class="lg:w-16 md:w-16 w-12 lg:mx-[88%] md:mx-[72%] mx-[84%] md:mt-[320px] mt-14 mb-0"
            src="/arrow--up.svg"
            width="64"
            height="64"
            loading="lazy"
            decoding="async"
            alt="Go to Top"
          />
        </a>
      </div>
    </div>
  </div>

  <div class="md:mt-12 mt-20 md:mb-14 mb-10 flex ibm-plex-serif-semibold md:text-[18px]">
    <a href="/#header" aria-label="The Creative Authority Home"><DotTCA /></a>
    <p class="ml-4 mt-1 md:text-[20px] text-[16px]">© 2025. All Rights Reserved.</p>
  </div>
</footer>

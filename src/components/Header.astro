---
import TcaLogo from "./TcaLogo.astro";
---

<header id="header" class="flex items-start justify-between">
  <div class="lg:ml-8 lg:w-48 w-32 lg:h-20 md:h-12 h-8">
    <a href="/" aria-label="The Creative Authority Home"><TcaLogo /></a>
  </div>
  <div class="lg:mt-[68px] md:mt-[34px] mt-[40px] md:mr-4 mr-2">
    <a href="#footer" aria-label="Jump to contact and footer">
      <img
        class="lg:w-[64px] md:w-[52px] w-[44px]"
        src="/ibm-watsonx--assistant.svg"
        width="64"
        height="64"
        alt="Talk to us"
      />
    </a>
  </div>
</header>

---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";

import womanStandsImg from "../assets/woman-stands.webp";
import heartImg from "../assets/heart.webp";
import storeScannerImg from "../assets/store-scanner.webp";
import shopifySetupImg from "../assets/shopify-setup.webp";
import alesiaImg from "../assets/alesia.webp";
import teamworkImg from "../assets/teamwork.webp";
import instoreImg from "../assets/instore.webp";
import shopifySeoImg from "../assets/ShopifySEO.webp";
import productionImg from "../assets/production.webp";
import tapAndBeepImg from "../assets/tap-and-beep.webp";
import directPurchaseImg from "../assets/directpurchase.webp";
import customerSupportImg from "../assets/customersupport.webp";
---

<Layout
  title="The Creative Authority | Shopify App Development & Design Agency"
  description="Pakistan's Premium Shopify App Development & Design Agency"
>
  <div>
    <div class="lg:ml-8 mt-20">
      <Image
        src={womanStandsImg}
        width={1168}
        height={570}
        loading="eager"
        fetchpriority="high"
        alt="Store owner standing confidently inside a retail boutique"
      />
    </div>
    <div>
      <h1 class="ibm-plex-serif-semibold lg:text-[52px] md:text-[42px] text-[20px] text-center lg:mt-16 md:mt-12 mt-6 lg:leading-[66px] md:leading-[54px]">
        Pakistan's Premium Shopify App<br />Development & Design Agency
      </h1>
    </div>

    <div class="md:flex md:flex-row-reverse lg:mt-20 md:mt-16 mt-6 lg:ml-8">
      <div class="md:w-[50%] md:ml-4 md:p-2 p-4 md:mt-0 mt-4">
        <Image
          src={heartImg}
          width={552}
          height={421}
          loading="lazy"
          alt="We grow together"
        />
      </div>

      <div class="ibm-plex-sans-regular md:text-[24px] text-[18px] md:w-[50%] mr-4 lg:leading-[36px] md:leading-[32px] leading-[28px]">
        <p>
          We craft exceptional commerce through thoughtful design and user experience (UX), supporting both new Brand launches as well as existing website optimisation.
        </p>

        <h3 class="ibm-plex-serif-semibold md:text-[32px] text-[20px] mt-8 mb-4 md:leading-[36px]">
          Customer Journey Experience
        </h3>

        <p>
          We specialise in crafting compelling customer journey experiences for your website, designed to build credibility and drive conversions. By focusing on intuitive navigation and personalised touchpoints, we ensure that every interaction with your brand is memorable and effective, leading to increased trust and successful outcomes.
        </p>
      </div>
    </div>

    <div class="lg:mt-32 md:mt-16 mt-10 lg:ml-8">
      <Image
        src={storeScannerImg}
        width={1450}
        height={514}
        loading="lazy"
        alt="Retail store barcode scanner at checkout"
      />
    </div>

    <div class="text-center lg:mt-20 md:mt-16 mt-8">
      <h2 class="ibm-plex-serif-semibold lg:text-[52px] md:text-[42px] text-[20px]">
        Meet Your Certified Shopify Partner
      </h2>
      <p class="ibm-plex-sans-regular lg:text-[36px] md:text-[32px] text-[18px]">
        Our Development Services Include:
      </p>
    </div>

    <div class="md:flex md:flex-row-reverse lg:mt-28 md:mt-24 mt-12 lg:ml-8">
      <div class="md:w-[50%] md:ml-4 md:p-2 p-4 md:mt-0 mt-4">
        <Image
          src={shopifySetupImg}
          width={586}
          height={372}
          loading="lazy"
          alt="Shopify store setup displayed on laptop"
        />
      </div>

      <div class="ibm-plex-sans-regular md:text-[24px] text-[18px] md:w-[50%] mr-4 lg:leading-[36px] md:leading-[32px] leading-[28px]">
        <h3 class="ibm-plex-serif-semibold md:text-[32px] text-[20px] mb-4">
          Shopify Store Set-up
        </h3>

        <p>
          Our experts will build your Shopify store from the scratch and make it up and running in no time. Initial store set-up includes creating the storefront with unique designs, developing product pages and listing products, adding initial layouts, and Shopify cart customisation.
        </p>
      </div>
    </div>

    <div class="md:flex lg:mt-28 md:mt-20 mt-12 lg:ml-8">
      <div class="md:w-[50%] md:mr-4 md:p-2 p-4">
        <Image
          src={alesiaImg}
          width={585}
          height={390}
          loading="lazy"
          alt="Custom Shopify theme design workspace"
        />
      </div>

      <div class="ibm-plex-sans-regular md:text-[24px] text-[18px] md:w-[50%] md:ml-4 lg:leading-[36px] md:leading-[32px] leading-[28px]">
        <h3 class="ibm-plex-serif-semibold md:text-[32px] text-[20px] mb-4 md:leading-[36px]">
          Shopify Theme Customisation
        </h3>

        <p>
          Your Shopify store’s theme matters a lot as it makes the first impression. Our team will add a customised theme to your Shopify store as per your product niche so that your brand can stand out from the competition. Our expert designers will make your store visually appealing in order to ensure a great customer experience and ultimately lower the bounce rate.
        </p>
      </div>
    </div>

    <div class="md:flex md:flex-row-reverse lg:mt-28 md:mt-20 mt-12 lg:ml-8">
      <div class="md:w-[50%] md:ml-4 md:p-2 p-4">
        <Image
          src={teamworkImg}
          width={583}
          height={389}
          loading="lazy"
          alt="Developers collaborating on Shopify store migration"
        />
      </div>

      <div class="ibm-plex-sans-regular md:text-[24px] text-[20px] md:w-[50%] mr-4 lg:leading-[36px] md:leading-[32px] leading-[28px]">
        <h3 class="ibm-plex-serif-semibold md:text-[32px] text-[20px] mb-4 md:leading-[36px]">
          Shopify Migration Services
        </h3>

        <p>
          Shopify facilitates its customers to carry their online store data from anywhere on Shopify. If you started your online journey at some other business platform but now want to shift to Shopify, we are here to do it for you. Our developers have migrated a countless number of stores onto Shopify without any hassle. Be it Wordpress, Magento, or any other site, we will safely and smoothly migrate your online store to Shopify in a short time span.
        </p>
      </div>
    </div>

    <div class="md:flex lg:mt-28 md:mt-20 mt-12 lg:ml-8">
      <div class="md:w-[50%] md:mr-4 md:p-2 p-4">
        <Image
          src={instoreImg}
          width={585}
          height={390}
          loading="lazy"
          alt="Third-party Shopify app and POS integration"
        />
      </div>
      <div class="ibm-plex-sans-regular md:text-[24px] text-[20px] md:w-[50%] md:ml-4 lg:leading-[36px] md:leading-[32px] leading-[28px]">
        <h3 class="ibm-plex-serif-semibold md:text-[32px] text-[20px] mb-4 md:leading-[36px]">
          Shopify Integration Services
        </h3>

        <p>
          We will integrate any third-party feature of your choice into your Shopify store in order to add custom functionality. Our team of developers aims to add maximum value to your Shopify store in order to make it versatile and fully functional.
        </p>
      </div>
    </div>

    <div class="md:flex md:flex-row-reverse lg:mt-28 md:mt-20 mt-12 lg:ml-8">
      <div class="md:w-[50%] md:ml-4 md:p-2 p-4">
        <Image
          src={shopifySeoImg}
          width={583}
          height={376}
          loading="lazy"
          alt="Woman searching online store on mobile phone"
        />
      </div>

      <div class="ibm-plex-sans-regular md:text-[24px] text-[18px] md:w-[50%] mr-4 lg:leading-[36px] md:leading-[32px] leading-[28px]">
        <h3 class="ibm-plex-serif-semibold md:text-[32px] text-[20px] mb-4">
          Shopify SEO
        </h3>

        <p>
          SEO is an integral part of any website development plan. We have SEO experts who will do thorough market research to devise an efficient SEO strategy for your Shopify store. Our SEO optimisation techniques hold the potential to take your store to new heights of success in terms of conversion and sales.
        </p>
      </div>
    </div>

    <div class="md:flex lg:mt-28 md:mt-20 mt-12 lg:ml-8">
      <div class="md:w-[50%] md:mr-4 md:p-2 p-4">
        <Image
          src={productionImg}
          width={586}
          height={391}
          loading="lazy"
          alt="Shopify store updates and ongoing maintenance"
        />
      </div>
      <div class="ibm-plex-sans-regular md:text-[24px] text-[18px] md:w-[50%] md:ml-4 lg:leading-[36px] md:leading-[32px] leading-[28px]">
        <h3 class="ibm-plex-serif-semibold md:text-[32px] text-[20px] mb-4 md:leading-[36px] leading-[28px]">
          Updates and Maintenance
        </h3>

        <p>
          A sustainable online store needs continuous improvements in order to stay ahead of the competition. Our team will not only manage your Shopify store but will timely update it for the betterment and ensure a seamless user experience.
        </p>
      </div>
    </div>

    <div class="lg:mt-36 md:mt-28 mt-16 lg:ml-8">
      <Image
        src={tapAndBeepImg}
        width={1447}
        height={518}
        loading="lazy"
        alt="Contactless tap-and-pay retail checkout"
      />
    </div>

    <div class="md:pl-24 pl-4 md:pr-24 pr-8 md:pt-16 pt-8 lg:text-[32px] md:text-[28px] text-[20px] ibm-plex-serif-regular lg:leading-[52px]">
      For e-commerce business owners, staying competitive goes beyond offering excellent products; it’s about delivering a superior shopping experience. Shopify users know that the key to enhancing their store lies in combining the right apps with custom Shopify theme development. These integration can elevate your store to the next level, improving customer usability & boosting your conversion rate.
    </div>

    <h2 class="mt-16 lg:pl-24 lg:pr-48 md:pl-20 md:pr-32 ibm-plex-sans-medium md:text-[32px] text-[24px] lg:leading-[52px] text-center">
      We build unified commerce solutions for every channel.
    </h2>

    <div class="flex mt-12 justify-center">
      <div class="lg:w-[350px] md:w-[260px] md:mr-8 mr-2">
        <Image
          src={directPurchaseImg}
          width={461}
          height={308}
          loading="lazy"
          alt="Direct-to-consumer online shopping transaction"
        />
        <h3 class="ibm-plex-sans-medium md:text-[28px] text-[20px] text-center mt-4">D2C</h3>
      </div>
      <div class="lg:w-[350px] md:w-[260px] md:ml-8 ml-2">
        <Image
          src={customerSupportImg}
          width={463}
          height={309}
          loading="lazy"
          alt="B2B commerce and dedicated customer support"
        />
        <h3 class="ibm-plex-sans-medium md:text-[28px] text-[20px] text-center mt-4">B2B</h3>
      </div>
    </div>

    <div class="md:mt-12 mt-12 mb-12 justify-center flex">
      <a href="/contact#header" class="bg-blue-800 text-white p-[50px] md:w-[460px] w-[300px] md:h-[240px] h-[200px]">
        <p class="mt-[-34px] md:ml-[-24px] ml-[-32px] ibm-plex-sans-semibold md:text-[38px] text-[26px]">GOT A PROJECT?</p>
        <p class="md:ml-[-20px] ml-[-30px] md:mt-[-6px] mt-[-4px] ibm-plex-sans-regular md:text-[26px] text-[18px]">Speak With Our Experts</p>
        <img class="size-14 md:mt-16 mt-14 md:ml-80 ml-44" src="/arrow--right.svg" width="56" height="56" loading="lazy" decoding="async" alt="Contact Us" />
      </a>
    </div>
  </div>
</Layout>

---
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <div class="md:flex md:flex-row-reverse lg:ml-8 mt-20">
    <div class="md:w-[50%]">
      <img src="/payphone.webp" alt="payphone on the wall" />
    </div>
    <div class="md:w-[50%]">
      <form id="contact-form" class="grid">
        <label class="carbonlabel">Name</label>
        <input class="carboninput" name="name" placeholder="Type your name" type="text" required />
        <label class="carbonlabel">Email</label>
        <input class="carboninput" name="email" type="email" placeholder="Type your email address" required />
        <label class="carbonlabel">Message</label>
        <textarea class="carboninput carbontextbox" name="message" placeholder="Type your message here" required></textarea>
        <div class="flex">
          <button class="carbonbutton" type="submit">Submit</button>
          <button class="carbonbutton carbonreset" type="reset">Reset</button>
        </div>
      </form>
      <div class="mt-4 ibm-plex-sans-regular text-[24px] text-red-700">
        <span id="form-result"></span>
      </div>
    </div>
  </div>
</Layout>

<script>
  const form = document.getElementById("contact-form") as HTMLFormElement | null;
  const resultSpan = document.getElementById("form-result");

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (resultSpan) resultSpan.textContent = "Sending....";

    const formData = new FormData(form);
    formData.append("access_key", "73f79c76-ec77-4ca3-a47e-f57248014056");

    const response = await fetch("https://api.web3forms.com/submit", {
      method: "POST",
      body: formData,
    });

    const data = await response.json();

    if (data.success) {
      if (resultSpan) resultSpan.textContent = "Form Submitted Successfully";
      window.location.href = "/success#header";
    } else {
      console.log("Error", data);
      if (resultSpan) resultSpan.textContent = data.message;
    }
  });
</script>


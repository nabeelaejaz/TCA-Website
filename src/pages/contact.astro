---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import payphoneImg from "../assets/payphone.webp";
---

<Layout
  title="Contact Us | The Creative Authority"
  description="Get in touch with The Creative Authority for Shopify store setup, theme customization, migration, and app development."
  ogImage="/payphone.webp"
>
  <div class="md:flex md:flex-row-reverse lg:ml-8 mt-20">
    <div class="md:w-[50%]">
      <Image
        src={payphoneImg}
        width={704}
        height={715}
        loading="eager"
        fetchpriority="high"
        alt="Vintage payphone mounted on the wall"
      />
    </div>
    <div class="md:w-[50%]">
      <h1 class="sr-only">Contact Us</h1>
      <form id="contact-form" class="grid">
        <label for="name" class="carbonlabel">Name</label>
        <input
          id="name"
          class="carboninput"
          name="name"
          placeholder="Type your name"
          type="text"
          autocomplete="name"
          required
        />
        <label for="email" class="carbonlabel">Email</label>
        <input
          id="email"
          class="carboninput"
          name="email"
          type="email"
          placeholder="Type your email address"
          autocomplete="email"
          required
        />
        <label for="message" class="carbonlabel">Message</label>
        <textarea
          id="message"
          class="carboninput carbontextbox"
          name="message"
          placeholder="Type your message here"
          required
        ></textarea>
        <div class="flex">
          <button id="submit-btn" class="carbonbutton" type="submit">Submit</button>
          <button class="carbonbutton carbonreset" type="reset">Reset</button>
        </div>
      </form>
      <div class="mt-4 ibm-plex-sans-regular text-[24px] text-red-700" aria-live="polite">
        <span id="form-result"></span>
      </div>
    </div>
  </div>
</Layout>

<script>
  const form = document.getElementById("contact-form") as HTMLFormElement | null;
  const submitBtn = document.getElementById("submit-btn") as HTMLButtonElement | null;
  const resultSpan = document.getElementById("form-result");

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (resultSpan) resultSpan.textContent = "Sending....";
    if (submitBtn) submitBtn.disabled = true;

    const formData = new FormData(form);
    formData.append("access_key", "73f79c76-ec77-4ca3-a47e-f57248014056");

    try {
      const response = await fetch("https://api.web3forms.com/submit", {
        method: "POST",
        body: formData,
      });

      const data = await response.json();

      if (data.success) {
        if (resultSpan) resultSpan.textContent = "Form Submitted Successfully";
        window.location.href = "/success#header";
      } else {
        if (resultSpan) resultSpan.textContent = data.message || "Something went wrong. Please try again.";
        if (submitBtn) submitBtn.disabled = false;
      }
    } catch {
      if (resultSpan) resultSpan.textContent = "Network error. Please check your connection and try again.";
      if (submitBtn) submitBtn.disabled = false;
    }
  });
</script>
